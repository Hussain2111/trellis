# ---------------------------------------------------------------------------
# Trellis — cloud-hosted (Vercel + Supabase), $0/month. Copy to `.env.local`
# for development, and set the same keys in the Vercel project for prod.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres) -------------------------------------------
# Use the connection pooler URL (port 6543, transaction mode), not the direct
# connection — Vercel functions are short-lived and can run many concurrently,
# which a direct connection's limit can't absorb.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trellis

# --- Model provider ----------------------------------------------------------
# Gemini free tier is the only LLM tier — no local model, nothing to benchmark.
LLM_PROVIDER=google
# Free key, no credit card: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-3.6-flash

# --- Scraping (Apify) ----------------------------------------------------------
APIFY_TOKEN=
# A profile-posts actor: plain username in, 1-200 posts out, no login/cookies.
APIFY_ACTOR=apify/instagram-profile-scraper
# live = spend Apify credits. fixture = replay ./fixtures offline, zero cost.
SCRAPE_MODE=fixture
# Monthly Apify credit allowance in USD, used for pre-scan budgeting.
APIFY_MONTHLY_CREDIT_USD=5
# Verifies the X-Apify-Webhook-... signature on the async scan-complete callback.
APIFY_WEBHOOK_SECRET=

# --- Instagram (Graph API: publishing + insights) -----------------------------
IG_HANDLE=
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- Guards --------------------------------------------------------------------
# When false, instantiating any provider that costs money throws at startup,
# naming the provider. There is no silent fallback to a billable API.
ALLOW_PAID_PROVIDERS=false
ENABLE_IG_PUBLISHING=false

# --- Cron auth -----------------------------------------------------------------
# Vercel sets this automatically as `Authorization: Bearer $CRON_SECRET` on its
# own cron invocations when this is set as a project env var. The GitHub Actions
# schedule sends the same header — store the identical value as the repository
# secret CRON_SECRET. Required in production; optional in local dev (the guard
# no-ops when unset).
CRON_SECRET=
