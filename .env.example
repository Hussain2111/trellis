# ---------------------------------------------------------------------------
# Trellis — local-first Instagram coach. Copy to `.env.local` and fill in.
# Everything here is free-tier or local. See docs/setup.md.
# ---------------------------------------------------------------------------

# --- Model routing ---------------------------------------------------------
# Tier A = free-tier cloud, rationed, all long-context reasoning.
# Tier B = local Ollama, unlimited, SHORT prompts only (embeddings, classify).
LLM_TIER_A=google
LLM_TIER_B=ollama

# Google AI Studio key (free, no credit card): https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Model ids are verified against the live API at startup; override if the
# defaults have been retired.
GOOGLE_MODEL=gemini-2.5-flash
GOOGLE_MODEL_LITE=gemini-2.5-flash-lite

OLLAMA_BASE_URL=http://localhost:11434
# Leave blank until `npm run bench:llm` has run — the benchmark picks this.
OLLAMA_MODEL=
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_KEEP_ALIVE=5m
# Hard ceiling on Tier B prompts. Oversized prompts throw rather than spend
# four minutes in prefill on an Iris Xe laptop.
TIER_B_MAX_PROMPT_TOKENS=800

# --- Images ----------------------------------------------------------------
# none = deterministic gradients only (fully functional).
# pollinations = free HTTP endpoint, no key, no SLA; degrades to gradient.
IMAGE_PROVIDER=none

# --- Scraping --------------------------------------------------------------
APIFY_TOKEN=
APIFY_ACTOR=apify/instagram-scraper
# live = spend Apify credits. fixture = replay ./fixtures offline, zero cost.
SCRAPE_MODE=fixture
# Monthly Apify credit allowance in USD, used for pre-scan budgeting.
APIFY_MONTHLY_CREDIT_USD=5

# --- Instagram -------------------------------------------------------------
IG_HANDLE=
# Publishing mode B only — see docs/instagram-setup.md (written at M11).
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- Transcription ---------------------------------------------------------
ENABLE_TRANSCRIPTION=true
TRANSCRIPTION_CAP=150
WHISPER_BIN=
WHISPER_MODEL_PATH=

# --- Guards ----------------------------------------------------------------
# When false, instantiating any provider that costs money throws at startup,
# naming the provider. There is no silent fallback to a billable API.
ALLOW_PAID_PROVIDERS=false
ENABLE_IG_PUBLISHING=false

# --- Privacy ---------------------------------------------------------------
# Google's free tier permits prompts to be used for product improvement.
# When true, the voice profile and chat coach stay on the local tier only.
LOCAL_ONLY_VOICE_AND_CHAT=false

# --- Local -----------------------------------------------------------------
DATABASE_PATH=./data/app.db
PORT=3000
